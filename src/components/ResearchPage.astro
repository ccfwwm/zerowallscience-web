---
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Icon from './Icon.astro';
import DownloadLink from './DownloadLink.astro';
import FeatureVisual from './FeatureVisual.astro';
import Community from './Community.astro';
import PromoVideo from './PromoVideo.astro';
import { release, releaseSize } from '../lib/release';
import type { SiteCopy } from '../content/site';
interface Props { t: SiteCopy; lang: 'en' | 'zh'; }
const { t, lang } = Astro.props;
---
<Base title={t.meta.title} description={t.meta.description} lang={lang}>
  <Nav lang={lang} t={t} />
  <main id="main">
    <section class="hero" id="top">
      <div class="hero-inner shell">
        <div class="hero-copy">
          <p class="eyebrow hero-eyebrow"><span class="status-dot"></span>{t.hero.eyebrow}</p>
          <h1>{t.hero.line1}<br /><span>{t.hero.line2}</span></h1>
          <p class="hero-sub">{t.hero.sub}</p>
          <div class="hero-actions"><DownloadLink label={t.download} /><a class="text-link" href="#film">{lang === 'zh' ? '看看它如何工作' : 'See it in action'}<Icon name="arrow" size={16} /></a></div>
          <p class="hero-release"><span data-release-version>v{release.version}</span><span>{t.hero.platform}</span></p>
        </div>
        <figure class="hero-device">
          <a class="hero-workspace" href="/assets/v2/app-workspace.webp" data-zoom data-zoom-label={t.realUI} aria-label={t.preview}>
            <div class="hero-window-bar" aria-hidden="true"><i></i><i></i><i></i><span>ZeroWall Science / Research workspace</span><Icon name="plus" size={12} /></div>
            <img src="/assets/v2/app-workspace.webp" width="1440" height="900" alt={lang === 'zh' ? 'ZeroWall Science 8.4.0 科研工具界面，包含显微图像、病理切片和分子结构查看入口' : 'ZeroWall Science 8.4.0 research tools: microscopy, histology and molecular viewers'} fetchpriority="high" />
          </a>
          <div class="hero-research-note"><span>RESEARCH, WITHOUT WALLS</span><strong>{lang === 'zh' ? '问题 → 方法 → 证据 → 成果' : 'Question → Method → Evidence → Output'}</strong></div>
          <figcaption class="hero-device-caption"><span class="status-dot"></span>{t.realUI}<Icon name="arrow" size={14} /></figcaption>
        </figure>
      </div>
    </section>
    <PromoVideo t={t} />
    <section class="research-intro shell" aria-labelledby="research-heading"><p class="eyebrow">RESEARCH, WITHOUT WALLS</p><h2 id="research-heading">{lang === 'zh' ? '一个科研工作台，' : 'One research workspace.'}<br class="mobile-break" />{lang === 'zh' ? '五种核心能力。' : ' Five core capabilities.'}</h2><p>{t.storyLabel}</p><nav class="story-index" aria-label={lang === 'zh' ? '科研能力章节' : 'Research chapters'}>{t.nav.map((label, i) => <a href={`#${t.features[i].id}`} data-story-link={i}><span>0{i + 1}</span>{label}<Icon name="down" size={15} /></a>)}</nav></section>
    <section class="research-story" aria-label={t.storyLabel} data-story>
      <div class="story-stage">
        <div class="story-panels shell">{t.features.map((feature, i) => <article class:list={['story-panel', `story-${feature.id}`]} id={feature.id} data-story-panel={i} aria-labelledby={`${feature.id}-title`}>
          <div class="feature-copy"><p class="feature-kicker"><span>{feature.kicker.slice(0, 2)}</span><span>{feature.kicker.slice(5)}</span></p><h2 id={`${feature.id}-title`}>{feature.title.split('\n').map(line => <span>{line}</span>)}</h2><p class="feature-description">{feature.desc}</p><ul class="feature-points">{feature.points.map(point => <li>{point}</li>)}</ul><p class="feature-output">{feature.output}</p><a class="text-link" href="https://zerowallscience.org/docs/" target="_blank" rel="noreferrer">{feature.link}<Icon name="arrow" size={17} /></a>{feature.id === 'knockout' && <details class="compute-details"><summary>{t.knockout.details}</summary><p>{t.knockout.detailText}</p></details>}</div>
          <FeatureVisual id={feature.id} t={t} lang={lang} />
        </article>)}</div>
      </div>
    </section>
    <section class="workflow-section section-pad" id="workflow">
      <div class="shell">
        <div class="section-heading" data-reveal><p class="eyebrow">{t.workflow.kicker}</p><h2>{t.workflow.title}</h2><p>{t.workflow.sub}</p></div>
        <div class="workflow-path"><div class="workflow-track" aria-hidden="true"><span class="workflow-progress" data-workflow-progress></span></div>{t.workflow.steps.map((step, i) => <article data-reveal><span class="workflow-number">0{i + 1}</span><div class="workflow-marker"><i></i></div><h3>{step.title}</h3><p>{step.desc}</p></article>)}</div>
      </div>
    </section>
    <section class="creative-section section-pad" id="creative"><div class="shell"><div class="section-heading" data-reveal><p class="eyebrow">{t.creative.kicker}</p><h2>{t.creative.title}</h2><p>{t.creative.sub}</p></div><div class="creative-grid"><article class="creative-card" data-reveal><div class="creative-image"><img src="/assets/v2/creative.webp" width="1536" height="1024" alt={t.creative.imageDesc} loading="lazy" /><span>{t.creative.illustration}</span></div><div class="creative-card-copy"><span>01 / IMAGE STUDIO</span><h3>{t.creative.image}</h3><p>{t.creative.imageDesc}</p></div></article><article class="creative-card media-card" data-reveal><div class="media-demo"><div class="media-filmstrip">{['cells', 'medicine', 'research'].map((name, i) => <div><img src={`/assets/v2/${name}.webp`} width="1536" height="1024" alt={`${t.creative.illustration} · 0${i + 1}`} loading="lazy" /><span>SHOT 0{i + 1}</span></div>)}</div><div class="media-timeline"><span class="timeline-head"></span><div class="timeline-shots"><i></i><i></i><i></i></div><div class="timeline-captions"></div><div class="timeline-wave" aria-hidden="true">{Array.from({length: 54}, (_, i) => <i style={`height:${8 + (Math.sin(i * 1.8) + 1) * 10}px`}></i>)}</div></div><div class="media-step-labels">{t.creative.mediaSteps.map((step, i) => <span>0{i + 1} / {step}</span>)}</div><span class="media-disclosure">{t.demo}</span></div><div class="creative-card-copy"><span>02 / MOTION & SOUND</span><h3>{t.creative.video}</h3><p>{t.creative.videoDesc}</p></div></article></div><p class="creative-note">{t.creative.note}</p></div></section>
    <section class="download-section section-pad" id="download"><div class="shell"><img class="download-mark" src="/assets/v2/zerowall-icon.png" width="56" height="56" alt="" /><p class="eyebrow">{t.downloadSection.kicker}</p><h2>{t.downloadSection.title.split('\n').map(line => <span>{line}</span>)}</h2><p class="download-sub">{t.downloadSection.sub}</p><div class="hero-actions"><DownloadLink label={t.download} /><a class="button button-secondary" href="https://github.com/ccfwwm/zerowallscience" target="_blank" rel="noreferrer">{t.downloadSection.source}<Icon name="external" size={16} /></a></div><p class="download-meta"><span data-release-version>v{release.version}</span><span>{t.hero.platform}</span><span data-release-size>{releaseSize}</span></p><a class="text-link" href="https://zerowallscience.org/docs/" target="_blank" rel="noreferrer">{t.downloadSection.docs}<Icon name="arrow" size={16} /></a></div></section>
    <Community t={t} />
  </main>
  <footer class="site-footer shell"><div><a class="brand" href="#top"><img src="/assets/v2/zerowall-icon.png" width="28" height="28" alt="" /><span>ZeroWall<span class="brand-light"> Science</span></span></a><p>{t.footer}</p></div><div class="footer-right"><div><a href="#community">{t.community.footer}</a><a href="https://zerowallscience.org/docs/" target="_blank" rel="noreferrer">{t.docs}</a><a href="https://github.com/ccfwwm/zerowallscience" target="_blank" rel="noreferrer">GitHub</a><a href="https://github.com/ccfwwm/zerowallscience/blob/main/LICENSE" target="_blank" rel="noreferrer">{t.license}</a><a href="#top" aria-label={t.back}>↑</a></div><small>© {new Date().getFullYear()} ZeroWall Science</small></div></footer>
  <dialog class="image-dialog" aria-label={t.preview}><div><p data-image-caption></p><button class="icon-button" data-dialog-close aria-label={t.close}><Icon name="close" /></button></div><img data-dialog-image src="/assets/v2/app-workspace.webp" alt="" /></dialog>
</Base>
