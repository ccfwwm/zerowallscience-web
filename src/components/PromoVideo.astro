---
import Icon from './Icon.astro';
import type { SiteCopy } from '../content/site';
interface Props { t: SiteCopy; }
const { t } = Astro.props;
const copy = t.film;
const source = 'https://zerowall.chengxunkeji.cn/webfiles/zerowallsciencevideo.mp4';
---
<section class="film-section" id="film" aria-labelledby="film-heading">
  <div class="shell">
    <div class="film-heading"><div><p class="eyebrow">{copy.eyebrow}</p><h2 id="film-heading">{copy.title}</h2></div><p>{copy.description}</p></div>
    <div class="film-player" data-promo-player data-loading-label={copy.loading} data-play-label={copy.play}>
      <video class="film-video" data-promo-video controls playsinline preload="none" poster="/assets/v2/promo-poster.webp" width="2560" height="1440" aria-label={copy.label} tabindex="0">
        <source src={source} type="video/mp4" />
        <p><a href={source}>{copy.fallback}</a></p>
      </video>
      <button type="button" class="film-launch" data-video-play hidden aria-label={copy.play}>
        <span class="film-play-icon"><Icon name="play" size={27} /></span>
      </button>
    </div>
    <p class="film-error" data-video-error hidden role="status">{copy.error} <a class="text-link" href={source} target="_blank" rel="noreferrer">{copy.fallback}<Icon name="external" size={15} /></a></p>
  </div>
</section>

<style>
  .film-section { padding-block: 60px 96px; }
  .film-section .shell { max-width: 1160px; }
  .film-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 35px; margin-bottom: 32px; }
  .film-heading h2 { font-size: clamp(28px, 2.5vw, 36px); margin-top: 15px; line-height: 1.4; }
  .film-heading > p { max-width: 350px; font-size: 16px; color: var(--muted); line-height: 1.8; }
  .film-player { position: relative; aspect-ratio: 16 / 9; border: 1px solid #92dafc30; border-radius: 20px; background: #0d1320; overflow: hidden; box-shadow: 0 24px 70px #0005, 0 0 60px #00d4ff06; isolation: isolate; }
  .film-video { width: 100%; height: 100%; display: block; object-fit: contain; }
  .film-launch { position: absolute; inset: 0; width: 100%; height: 100%; display: grid; place-items: center; padding: 0; color: #fff; background: transparent; }
  .film-launch:focus-visible { outline-offset: -7px; border-radius: inherit; }
  .film-play-icon { display: grid; place-items: center; width: 76px; height: 76px; border: 1px solid #efffff90; border-radius: 50%; background: #07162426; backdrop-filter: blur(4px); color: #fff; box-shadow: 0 4px 24px #06132214; transition: transform .2s, background .2s, opacity .2s; }
  .film-play-icon svg { margin-left: 4px; filter: drop-shadow(0 1px 3px #06132280); }
  .film-launch:hover .film-play-icon { transform: scale(1.06); background: #07162440; }
  .film-launch[aria-busy="true"] .film-play-icon { opacity: .6; }
  .film-error { margin-top: 16px; font-size: 15px; line-height: 1.8; color: var(--muted); }
  .film-error a { margin-left: 8px; font-size: 15px; }
  @media (max-width: 767px) {
    .film-section { padding-block: 32px 64px; }
    .film-heading { flex-direction: column; align-items: flex-start; gap: 15px; margin-bottom: 24px; }
    .film-heading .eyebrow { font-size: 11px; }
    .film-heading h2 { font-size: 29px; }
    .film-heading > p { font-size: 16px; }
    .film-player { border-radius: 12px; }
    .film-play-icon { width: 48px; height: 48px; }
    .film-play-icon svg { width: 21px; height: 21px; }
  }
</style>
