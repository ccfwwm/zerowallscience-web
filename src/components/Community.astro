---
import Icon from './Icon.astro';
import type { SiteCopy } from '../content/site';
interface Props { t: SiteCopy; }
const { t } = Astro.props;
const copy = t.community;
const original = '/assets/v2/wechat-group-2.png';
---
<section class="community-section section-pad" id="community" aria-labelledby="community-heading">
  <div class="community-layout shell">
    <div class="community-copy">
      <p class="eyebrow">ZEROWALL COMMUNITY</p>
      <h2 id="community-heading">{copy.title.split('\n').map(line => <span>{line}</span>)}</h2>
      <p class="community-description">{copy.description}</p>
      <ul class="community-topics" aria-label={copy.topicsLabel}>{copy.topics.map(topic => <li>{topic}</li>)}</ul>
      <div class="community-actions">
        <a class="button button-secondary" href={original} data-zoom data-zoom-kind="qr" data-zoom-label={copy.preview} aria-haspopup="dialog">{copy.enlarge}<Icon name="plus" size={18} /></a>
        <a class="text-link" href={original} download="ZeroWallScience-WeChat-Group-2.png">{copy.save}<Icon name="download" size={18} /></a>
      </div>
      <p class="community-instructions">{copy.instructions}</p>
    </div>
    <figure class="community-qr">
      <div class="community-group"><span class="status-dot" aria-hidden="true"></span><span>{copy.group}</span><span class="community-group-badge">{copy.groupNumber}</span></div>
      <a class="community-code" href={original} data-zoom data-zoom-kind="qr" data-zoom-label={copy.preview} aria-label={copy.enlarge} aria-haspopup="dialog"><img src="/assets/v2/wechat-group-2-code.png" alt={copy.alt} width="400" height="400" loading="lazy" /></a>
      <figcaption><strong>{copy.scan}</strong><span>{copy.validUntil}<time datetime="2026-10-26">{copy.date}</time></span></figcaption>
    </figure>
  </div>
</section>

<style>
  .community-section { border-top: 1px solid var(--line); scroll-margin-top: var(--nav); background: radial-gradient(ellipse at 75% 50%, #00d4ff07, transparent 55%); }
  .community-layout { display: grid; grid-template-columns: minmax(0, 1fr) 350px; gap: clamp(50px, 8vw, 130px); align-items: center; }
  .community-copy h2 { margin: 24px 0; font-size: clamp(38px, 4vw, 54px); line-height: 1.3; letter-spacing: -.01em; }
  .community-copy h2 span { display: block; }
  .community-description { max-width: 590px; font-size: 19px; line-height: 1.85; color: var(--muted); }
  .community-topics { display: flex; flex-wrap: wrap; gap: 12px 24px; margin-top: 26px; padding: 0; list-style: none; font-size: 16px; color: var(--fg); }
  .community-topics li { display: flex; align-items: center; gap: 9px; }
  .community-topics li::before { content: ''; width: 5px; height: 5px; background: var(--cyan); transform: rotate(45deg); }
  .community-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 22px; margin-top: 32px; }
  .community-instructions { margin-top: 18px; color: var(--muted); font-size: 15px; line-height: 1.8; }
  .community-qr { margin: 0; padding: 25px; border: 1px solid var(--line2); border-radius: 20px; background: var(--surface); box-shadow: 0 20px 70px #0003; }
  .community-group { display: flex; align-items: center; justify-content: center; gap: 9px; margin-bottom: 20px; font-size: 16px; font-weight: 600; }
  .community-group-badge { font-size: 14px; padding: 3px 8px; border: 1px solid #00d4ff30; border-radius: 5px; color: var(--cyan); white-space: nowrap; }
  .community-code { display: block; overflow: hidden; border-radius: 10px; background: #fafafa; }
  .community-code img { display: block; width: 100%; height: auto; }
  figcaption { margin-top: 20px; text-align: center; }
  figcaption strong { display: block; font-size: 17px; font-weight: 600; }
  figcaption > span { display: block; margin-top: 8px; font-size: 14px; color: var(--muted); line-height: 1.7; }
  @media (max-width: 900px) {
    .community-layout { grid-template-columns: minmax(0, 1fr) 310px; gap: 32px; }
    .community-description { font-size: 17px; }
    .community-copy h2 { font-size: 36px; }
    .community-qr { padding: 20px; }
    .community-group { flex-wrap: wrap; font-size: 15px; }
  }
  @media (max-width: 767px) {
    .community-layout { grid-template-columns: 1fr; gap: 36px; }
    .community-copy h2 { font-size: 34px; }
    .community-description { font-size: 17px; }
    .community-qr { width: min(350px, 100%); justify-self: center; }
    .community-topics { gap: 12px 20px; }
    .community-actions { gap: 18px; }
  }
</style>
