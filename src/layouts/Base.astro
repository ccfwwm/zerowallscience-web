---
// Base layout — shared across EN and ZH pages
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: 'en' | 'zh';
}
const { title, description, lang } = Astro.props;
---
<!DOCTYPE html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'} data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={lang === 'zh' ? 'https://zerowallscience.org/zh' : 'https://zerowallscience.org'} />
  <link rel="alternate" hreflang="en" href="https://zerowallscience.org" />
  <link rel="alternate" hreflang="zh" href="https://zerowallscience.org/zh" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&family=Source+Serif+4:wght@400;600&display=swap" rel="stylesheet" />
</head>
<body>
  <!-- Full-page life-science background (fixed, behind all content) -->
  <div id="zw-bg-canvas" class="fixed inset-0 z-0 pointer-events-none" aria-hidden="true"></div>
  <div class="relative z-10">
    <slot />
  </div>
  <script is:inline>
    // Theme init (runs before paint)
    (function() {
      const saved = localStorage.getItem('zw-theme');
      const theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
  <!-- Background animation (React island, client-only) -->
  <script>
    import { createElement } from 'react';
    import { createRoot } from 'react-dom/client';
    import HeroCanvas from '../components/HeroCanvas';
    const mount = document.getElementById('zw-bg-canvas');
    if (mount) createRoot(mount).render(createElement(HeroCanvas));
  </script>
</body>
</html>
