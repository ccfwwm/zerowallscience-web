---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { en as t } from '../content/site.en';
---
<Base title={t.meta.title} description={t.meta.description} lang="en">
  <Nav lang="en" nav={t.nav} />

  <!-- Hero -->
  <section class="relative min-h-screen flex items-center justify-center pt-16 overflow-hidden" id="hero">
    <div class="absolute top-[-30%] left-1/2 -translate-x-1/2 w-[140%] h-[80%] rounded-full bg-[radial-gradient(ellipse,var(--accent-glow)_0%,transparent_70%)] opacity-50 blur-[100px] pointer-events-none animate-pulse"></div>
    <!-- Floating orbs for depth -->
    <div class="absolute top-[20%] left-[10%] w-64 h-64 rounded-full bg-[var(--hero-gradient-2)] opacity-[0.08] blur-[80px] animate-[float_12s_ease-in-out_infinite]"></div>
    <div class="absolute bottom-[20%] right-[10%] w-48 h-48 rounded-full bg-[var(--hero-gradient-1)] opacity-[0.06] blur-[60px] animate-[float_8s_ease-in-out_infinite_reverse]"></div>
    <div class="relative z-10 text-center max-w-[800px] px-6">
      <div class="mb-8 animate-[fadeIn_1s_ease]">
        <img src="/assets/source-lockup.jpg" alt="ZeroWall Science" class="w-48 h-48 sm:w-56 sm:h-56 mx-auto rounded-3xl shadow-pop object-contain drop-shadow-[0_0_40px_var(--accent-glow)]" />
      </div>
      <h1 class="text-[clamp(2.5rem,6vw,4.5rem)] font-extrabold leading-[1.1] tracking-tight bg-clip-text text-transparent mb-5 animate-[fadeUp_0.8s_ease] bg-[linear-gradient(110deg,var(--text),var(--hero-gradient-1),var(--hero-gradient-2),var(--hero-gradient-1),var(--text))] bg-[length:250%_auto] [animation:fadeUp_0.8s_ease,flowGradient_8s_linear_infinite]">
        {t.hero.title}
      </h1>
      <p class="text-[clamp(1rem,2vw,1.25rem)] text-muted max-w-[600px] mx-auto mb-9 leading-relaxed animate-[fadeUp_1s_ease]">
        {t.hero.sub}
      </p>
      <div class="flex gap-3.5 justify-center flex-wrap animate-[fadeUp_1.2s_ease]">
        <a href="#download" class="group px-7 py-3.5 rounded-input bg-accent text-accent-fg font-semibold text-[15px] shadow-[0_4px_16px_var(--accent-glow)] hover:-translate-y-0.5 hover:shadow-[0_8px_24px_var(--accent-glow)] transition-all inline-flex items-center gap-2">
          {t.hero.cta}
          <span class="group-hover:translate-y-0.5 transition-transform">↓</span>
        </a>
      </div>
      <div class="flex justify-center gap-12 mt-16 pt-8 border-t border-border-faint flex-wrap animate-[fadeUp_1.4s_ease]">
        {t.hero.stats.map(s => (
          <div class="text-center">
            <div class="text-2xl font-extrabold text-accent font-mono">{s.value}</div>
            <div class="text-xs text-muted mt-1">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Research Loop -->
  <section id="loop" class="py-24">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="text-center mb-16">
        <span class="inline-block px-3 py-1 rounded-xl bg-accent-glow text-accent text-xs font-semibold uppercase tracking-wider mb-4">{t.loop.tag}</span>
        <h2 class="text-[clamp(1.8rem,4vw,2.8rem)] font-bold tracking-tight mb-4">{t.loop.title}</h2>
        <p class="text-muted text-lg max-w-[600px] mx-auto">{t.loop.sub}</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {t.loop.steps.map((s, i) => (
          <div class="bg-surface border border-border-faint rounded-card p-7 text-center relative hover:border-accent hover:-translate-y-1 transition-all group">
            <div class="w-12 h-12 rounded-full mx-auto mb-4 bg-accent-glow text-accent flex items-center justify-center font-bold text-lg group-hover:scale-110 transition-transform">{i + 1}</div>
            <h3 class="font-semibold mb-2 text-lg">{s.title}</h3>
            <p class="text-sm text-muted leading-relaxed">{s.desc}</p>
            {i < 3 && <div class="absolute -right-2 top-1/2 -translate-y-1/2 text-accent text-xl z-10 hidden lg:block opacity-50">→</div>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="py-24">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="text-center mb-16">
        <span class="inline-block px-3 py-1 rounded-xl bg-accent-glow text-accent text-xs font-semibold uppercase tracking-wider mb-4">{t.features.tag}</span>
        <h2 class="text-[clamp(1.8rem,4vw,2.8rem)] font-bold tracking-tight mb-4">{t.features.title}</h2>
        <p class="text-muted text-lg max-w-[600px] mx-auto">{t.features.sub}</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {t.features.items.map(f => (
          <div class="bg-surface border border-border-faint rounded-card p-7 relative overflow-hidden transition-all hover:border-accent hover:-translate-y-1 hover:shadow-[0_12px_40px_var(--accent-glow)] group">
            <div class="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-[var(--hero-gradient-1)] to-[var(--hero-gradient-2)] opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="w-12 h-12 rounded-xl mb-4 bg-accent-glow flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">{f.icon}</div>
            <h3 class="font-semibold mb-2">{f.title}</h3>
            <p class="text-sm text-muted leading-relaxed">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section id="capabilities" class="py-24">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="text-center mb-16">
        <span class="inline-block px-3 py-1 rounded-xl bg-accent-glow text-accent text-xs font-semibold uppercase tracking-wider mb-4">{t.capabilities.tag}</span>
        <h2 class="text-[clamp(1.8rem,4vw,2.8rem)] font-bold tracking-tight mb-4">{t.capabilities.title}</h2>
        <p class="text-muted text-lg max-w-[600px] mx-auto">{t.capabilities.sub}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {t.capabilities.items.map(c => (
          <div class="p-6 rounded-card border border-border-faint hover:border-accent transition-all hover:bg-[var(--card-hover-bg)] group">
            <div class="w-2 h-2 rounded-full bg-accent mb-4 group-hover:scale-150 transition-transform"></div>
            <h3 class="font-semibold mb-2">{c.title}</h3>
            <p class="text-sm text-muted leading-relaxed">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why ZeroWall + Comparison -->
  <section id="compare" class="py-24 relative overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] h-[60%] rounded-full bg-[radial-gradient(ellipse,var(--accent-glow)_0%,transparent_70%)] opacity-30 blur-[120px] pointer-events-none"></div>
    <div class="max-w-[1200px] mx-auto px-6 relative">
      <div class="text-center mb-14">
        <span class="inline-block px-3 py-1 rounded-xl bg-accent-glow text-accent text-xs font-semibold uppercase tracking-wider mb-4">{t.whyus.tag}</span>
        <h2 class="text-[clamp(1.8rem,4vw,2.8rem)] font-bold tracking-tight mb-4">{t.whyus.title}</h2>
        <p class="text-muted text-lg max-w-[640px] mx-auto">{t.whyus.sub}</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-20">
        {t.whyus.items.map(w => (
          <div class="bg-surface border border-border-faint rounded-card p-7 relative overflow-hidden transition-all hover:border-accent hover:-translate-y-1 hover:shadow-[0_12px_40px_var(--accent-glow)] group">
            <div class="w-12 h-12 rounded-xl mb-4 bg-accent-glow flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">{w.icon}</div>
            <h3 class="font-semibold mb-2">{w.title}</h3>
            <p class="text-sm text-muted leading-relaxed">{w.desc}</p>
          </div>
        ))}
      </div>

      <div class="text-center mb-10">
        <h3 class="text-[clamp(1.5rem,3vw,2rem)] font-bold tracking-tight mb-3">{t.comparison.title}</h3>
        <p class="text-muted max-w-[600px] mx-auto">{t.comparison.sub}</p>
      </div>
      <div class="overflow-x-auto rounded-card border border-border-faint bg-surface shadow-pop">
        <table class="w-full min-w-[760px] border-collapse text-sm">
          <thead>
            <tr class="border-b border-border">
              <th class="text-left font-semibold text-muted p-4 w-[180px] sticky left-0 bg-surface z-10"></th>
              {t.comparison.columns.map((c, i) => (
                <th class={`p-4 text-center font-bold whitespace-nowrap ${i === 0 ? 'text-accent bg-accent-glow rounded-t-lg' : 'text-text'}`}>
                  {i === 0 && <span class="block text-[10px] uppercase tracking-wider text-accent/70 font-semibold mb-0.5">★ This project</span>}
                  {c}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {t.comparison.rows.map((row, ri) => (
              <tr class={ri % 2 === 1 ? 'bg-[var(--surface-2)]/40' : ''}>
                <td class="p-4 font-semibold text-text align-top sticky left-0 bg-inherit z-10 border-r border-border-faint">{row.label}</td>
                {row.cells.map((cell, ci) => (
                  <td class={`p-4 align-top text-center ${ci === 0 ? 'bg-accent-glow' : ''}`}>
                    <span class={`inline-flex items-center justify-center w-5 h-5 rounded-full text-[11px] font-bold mb-1 ${cell.s === 'yes' ? 'bg-[#16a34a]/15 text-[#16a34a]' : cell.s === 'no' ? 'bg-[#dc2626]/15 text-[#dc2626]' : 'bg-[#d97706]/15 text-[#d97706]'}`}>
                      {cell.s === 'yes' ? '✓' : cell.s === 'no' ? '✕' : '◐'}
                    </span>
                    <span class={`block text-xs leading-snug ${ci === 0 ? 'text-text font-medium' : 'text-muted'}`}>{cell.t}</span>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-muted/70 mt-4 text-center max-w-[720px] mx-auto">{t.comparison.note}</p>
    </div>
  </section>

  <!-- Architecture -->
  <section id="architecture" class="py-24">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="text-center mb-16">
        <span class="inline-block px-3 py-1 rounded-xl bg-accent-glow text-accent text-xs font-semibold uppercase tracking-wider mb-4">{t.architecture.tag}</span>
        <h2 class="text-[clamp(1.8rem,4vw,2.8rem)] font-bold tracking-tight mb-4">{t.architecture.title}</h2>
        <p class="text-muted text-lg max-w-[600px] mx-auto">{t.architecture.sub}</p>
      </div>
      <div class="bg-surface border border-border-faint rounded-card p-12 max-w-[750px] mx-auto relative overflow-hidden">
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,var(--accent-glow),transparent_70%)] opacity-30 pointer-events-none"></div>
        <div class="relative flex flex-col gap-3">
          {t.architecture.layers.map((l, i) => (
            <Fragment>
              <div class="flex items-center gap-4 p-4 rounded-input border border-border hover:border-accent hover:bg-accent-glow transition-all group">
                <div class="w-10 h-10 rounded-lg bg-accent-glow flex items-center justify-center text-lg shrink-0 group-hover:scale-110 transition-transform">{l.icon}</div>
                <div>
                  <div class="font-semibold text-[0.95rem]">{l.name}</div>
                  <div class="text-xs text-muted mt-0.5">{l.desc}</div>
                </div>
              </div>
              {i < t.architecture.dividers.length && (
                <div class="text-center text-[11px] text-muted uppercase tracking-widest py-1 relative">
                  <span class="relative z-10 bg-surface px-4">{t.architecture.dividers[i]}</span>
                  <div class="absolute top-1/2 left-0 right-0 h-px bg-border -z-0"></div>
                </div>
              )}
            </Fragment>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Download -->
  <section id="download" class="py-24">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="text-center mb-16">
        <span class="inline-block px-3 py-1 rounded-xl bg-accent-glow text-accent text-xs font-semibold uppercase tracking-wider mb-4">{t.download.tag}</span>
        <h2 class="text-[clamp(1.8rem,4vw,2.8rem)] font-bold tracking-tight mb-4">{t.download.title}</h2>
        <p class="text-muted text-lg max-w-[600px] mx-auto">{t.download.sub}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 max-w-[900px] mx-auto">
        {t.download.platforms.map(p => (
          <div class="bg-surface border border-border-faint rounded-card p-8 text-center hover:border-accent hover:-translate-y-1 hover:shadow-pop transition-all">
            <div class="text-[40px] mb-4">{p.icon}</div>
            <h3 class="text-lg font-semibold mb-2">{p.name}</h3>
            <p class="text-xs text-muted mb-4">{p.note}</p>
            {p.status === 'available' ? (
              <a href="https://zerowall.chengxunkeji.cn/releases-zerowallsciencedev/latest/ZeroWall-Science-Setup.exe" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-input bg-accent text-accent-fg font-semibold text-sm hover:-translate-y-0.5 hover:shadow-[0_4px_12px_var(--accent-glow)] transition-all">
                ⬇ {p.statusLabel}
              </a>
            ) : (
              <span class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-input bg-surface-2 text-muted font-medium text-sm border border-border-faint cursor-default">
                {p.statusLabel}
              </span>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Community -->
  <section id="community" class="py-24 relative overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[80%] h-[60%] rounded-full bg-[radial-gradient(ellipse,var(--accent-glow)_0%,transparent_70%)] opacity-30 blur-[120px] pointer-events-none"></div>
    <div class="max-w-[1200px] mx-auto px-6 relative">
      <div class="text-center mb-12">
        <span class="inline-block px-3 py-1 rounded-xl bg-accent-glow text-accent text-xs font-semibold uppercase tracking-wider mb-4">{t.community.tag}</span>
        <h2 class="text-[clamp(1.8rem,4vw,2.8rem)] font-bold tracking-tight mb-4">{t.community.title}</h2>
        <p class="text-muted text-lg max-w-[600px] mx-auto">{t.community.sub}</p>
      </div>
      <div class="bg-surface border border-border-faint rounded-card p-8 max-w-[360px] mx-auto text-center shadow-pop hover:border-accent hover:-translate-y-1 transition-all">
        <img src="/assets/wechat-group.jpg?v=20260815" alt={t.community.qrAlt} width="1117" height="1241" class="w-full h-auto max-w-[280px] mx-auto rounded-input bg-white" />
        <p class="font-semibold text-text mt-5">{t.community.caption}</p>
        <p class="text-sm font-medium text-accent mt-3">{t.community.contact}</p>
        <p class="text-xs text-muted/70 mt-2 leading-relaxed">{t.community.hint}</p>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-border-faint py-10 text-center text-muted text-sm">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="flex items-center justify-center gap-2 mb-3">
        <img src="/assets/app-icon.png" alt="" class="w-5 h-5 rounded" />
        <span class="font-semibold text-text">ZeroWall Science</span>
      </div>
      <p>{t.footer.copyright} · {t.footer.tagline}</p>
    </div>
  </footer>

</Base>

<style is:global>
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-20px); }
  }
  @keyframes flowGradient {
    0% { background-position: 0% center; }
    100% { background-position: 250% center; }
  }
  @media (prefers-reduced-motion: reduce) {
    h1[class*="flowGradient"] { animation: fadeUp 0.8s ease !important; }
  }
</style>
